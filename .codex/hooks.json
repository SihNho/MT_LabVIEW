{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"G:/Codes/LabVIEW_Codes/MinLab/zz_LabView VI/AAA_UNIST/2. Tracking/V6_ParallelLoop/tools/hooks/guard_bash.py\"",
            "timeout": 15,
            "statusMessage": "guard: LabVIEW commands must be short or backgrounded"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"G:/Codes/LabVIEW_Codes/MinLab/zz_LabView VI/AAA_UNIST/2. Tracking/V6_ParallelLoop/tools/hooks/adapt_codex.py\"",
            "timeout": 200,
            "statusMessage": "guardcore: common guard (card chat-X2) - every tool, fail closed"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\lv_stallcheck.ps1\"",
            "timeout": 90,
            "statusMessage": "checking for stalled LabVIEW clients"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"G:/Codes/LabVIEW_Codes/MinLab/zz_LabView VI/AAA_UNIST/2. Tracking/V6_ParallelLoop/tools/hooks/answer_first.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
