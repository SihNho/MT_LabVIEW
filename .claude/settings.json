{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "PowerShell(& .\\tools\\lv_gui.ps1 *)",
      "PowerShell(& .\\tools\\peer.ps1 *)",
      "PowerShell(py *)",
      "PowerShell(Stop-Process -Name LabVIEW *)",
      "PowerShell(Get-Process *)",
      "Read",
      "mcp__ccd_session_mgmt__send_message",
      "Glob",
      "Grep",
      "Bash(ls *)",
      "Bash(tasklist *)",
      "Bash(certutil -hashfile *)",
      "Bash(py tools/*)",
      "Edit(**/*.md)",
      "Edit(tools/*.ps1)",
      "PowerShell(py tools\\gemini_executor.py *)",
      "Bash(py tools/gemini_executor.py *)",
      "PowerShell(py tools\\uitars_grounder.py *)",
      "Bash(py tools/uitars_grounder.py *)",
      "PowerShell(ollama *)",
      "PowerShell(& *llama-server* *)"
    ],
    "deny": [
      "Edit(**/*.vi)",
      "Write(**/*.vi)",
      "Edit(**/*.ctl)",
      "Write(**/*.ctl)",
      "Edit(**/*.lvlib)",
      "Write(**/*.lvlib)",
      "Edit(**/*.lvproj)",
      "Write(**/*.lvproj)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"G:/Codes/LabVIEW_Codes/MinLab/zz_LabView VI/AAA_UNIST/2. Tracking/V6_lean/tools/hooks/guard_lean.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_lean\\tools\\lv_stallcheck.ps1\"",
            "timeout": 90,
            "statusMessage": "checking for stalled LabVIEW clients"
          }
        ]
      }
    ]
  }
}