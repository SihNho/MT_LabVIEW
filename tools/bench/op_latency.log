import os,sys,time,statistics as st
sys.path.insert(0,os.path.abspath('tools'))
import gscript as g
g._lv=None
WORK=r'G:\Codes\LabVIEW_Codes\MinLab\zz_LabView VI\AAA_UNIST\2. Tracking\Min_Track N beads V6_ParallelLoop.vi'
SMALL=os.path.join(g.CLAUDEDEV,'OpReport_v3.vi')

def timeit(fn,n=1):
    ts=[]
    for _ in range(n):
        t0=time.perf_counter(); fn(); ts.append((time.perf_counter()-t0)*1000)
    return ts

# 1. bare op run, no target work: how long is ONE _run round trip?
vi=g.op(g.OP_REPORT)
vi.SetControlValue('vi path',SMALL); vi.SetControlValue('Class Name','Property'); vi.SetControlValue('index',0)
ts=timeit(lambda: g._run(vi),20)
print('bare _run on a SMALL vi      median %.1f ms  min %.1f  max %.1f'%(st.median(ts),min(ts),max(ts)),flush=True)

# 2. same but pointed at the BIG main VI - does target size change per-call cost?
vi.SetControlValue('vi path',WORK); vi.SetControlValue('Class Name','Property'); vi.SetControlValue('index',0)
ts=timeit(lambda: g._run(vi),20)
print('bare _run on the MAIN vi     median %.1f ms  min %.1f  max %.1f'%(st.median(ts),min(ts),max(ts)),flush=True)

# 3. SetControlValue cost alone (no run)
ts=timeit(lambda: vi.SetControlValue('index',3),50)
print('SetControlValue alone        median %.3f ms'%st.median(ts),flush=True)

# 4. GetControlValue cost alone
ts=timeit(lambda: vi.GetControlValue('UID'),50)
print('GetControlValue alone        median %.3f ms'%st.median(ts),flush=True)
