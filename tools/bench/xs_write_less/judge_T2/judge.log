{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013prJLVcMZH6JFbxopg2qYm","type":"tool_result","content":"1\t# ---\n2\t# labview: none\n3\t# hardware: none\n4\t# ---\n5\t\"\"\"el_diff.py - Error List items in one read but not the other (per item class, with counts), then a RESULT line.\n6\t\n7\t  py el_diff.py <errorlist_a.json> <errorlist_b.json>\n8\t\n9\tItem class = errorlist_check.class_counts(items, ocr=True) key (raw text normalised, OCR aliases folded), so an OCR\n10\tspelling change ('anvthing') or spacing change is not reported as a difference. No second parser or normaliser.\n11\t\"\"\"\n12\timport json\n13\timport os\n14\timport sys\n15\tfrom collections import Counter\n16\t\n17\tHERE = os.path.dirname(os.path.abspath(__file__))\n18\tTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\n19\tsys.path.insert(0, TOOLS)\n20\tfrom errorlist_check import class_counts, norm_ocr  # noqa: E402\n21\t\n22\t\n23\t# shortcut: compares by item text only, so two same-text items at different diagram places are one class with a\n24\t# count; upgrade to a position/uid key once Error List reads carry the object uid (today uid=None).\n25\tdef diff(items_a, items_b):\n26\t    \"\"\"(only_a, only_b): {class key: surplus count} for each side.\"\"\"\n27\t    ca, cb = Counter(class_counts(items_a, ocr=True)), Counter(class_counts(items_b, ocr=True))\n28\t    return dict(ca - cb), dict(cb - ca)\n29\t\n30\t\n31\tdef label(items, key):\n32\t    \"\"\"The first raw text in items whose class key is key (readable name for a folded key).\"\"\"\n33\t    return next((it.get(\"raw\") for it in items if norm_ocr(it.get(\"raw\")) == key), key)\n34\t\n35\t\n36\t_a = [{\"raw\": \"Wire: Wire has loose ends.\"}, {\"raw\": \"This wire is not connected to anything.\"}] * 2\n37\t_b = [{\"raw\": \"This wire is not connected to anvthing.\"}, {\"raw\": \"Wire:Wire has loose ends.\"}]\n38\tassert diff(_a, _b) == ({norm_ocr(_a[0][\"raw\"]): 1, norm_ocr(_a[1][\"raw\"]): 1}, {})\n39\tassert diff([], []) == ({}, {})\n40\tassert diff([], _b)[1] and not diff([], _b)[0]\n41\tassert label(_b, norm_ocr(\"Wire: Wire has loose ends.\")) == \"Wire:Wire has loose ends.\"\n42\t\n43\tif len(sys.argv) != 3:\n44\t    print(\"RESULT \" + json.dumps({\"ok\": False, \"why\": \"usage: el_diff.py <a.json> <b.json>\"}))\n45\t    sys.exit(2)\n46\tpaths = sys.argv[1:]\n47\tmissing = [p for p in paths if not os.path.isfile(p)]\n48\tif missing:\n49\t    print(\"RESULT \" + json.dumps({\"ok\": False, \"why\": \"missing file\", \"files\": missing}))\n50\t    sys.exit(1)\n51\t\n52\treads = [json.load(open(p, encoding=\"utf-8\")) for p in paths]\n53\titems = [r.get(\"items\") or [] for r in reads]\n54\tonly = diff(items[0], items[1])\n55\tfor side, (p, its, d) in enumerate(zip(paths, items, only)):\n56\t    print(\"only in %s (%d of %d items):\" % (os.path.basename(p), sum(d.values()), len(its)))\n57\t    for k, n in sorted(d.items()):\n58\t        print(\"  %2d x %s\" % (n, label(its, k)))\n59\t    if not d:\n60\t        print(\"  (none)\")\n61\tprint(\"RESULT \" + json.dumps({\n62\t    \"ok\": True, \"n_items\": [len(i) for i in items], \"n_reported\": [r.get(\"n_reported\") for r in reads],\n63\t    \"only_a\": {label(items[0], k): n for k, n in only[0].items()},\n64\t    \"only_b\": {label(items[1], k): n for k, n in only[1].items()}}))\n65\t"}]},"parent_tool_use_id":null,"session_id":"f01a795a-68db-442a-a5fd-a3e8bac13d80","uuid":"242e592e-a23b-4c05-9d5e-251e627463fe","timestamp":"2026-10-12T13:00:49.172Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T2\\pair2_B.py","content":"# ---\n# labview: none\n# hardware: none\n# ---\n\"\"\"el_diff.py - Error List items in one read but not the other (per item class, with counts), then a RESULT line.\n\n  py el_diff.py <errorlist_a.json> <errorlist_b.json>\n\nItem class = errorlist_check.class_counts(items, ocr=True) key (raw text normalised, OCR aliases folded), so an OCR\nspelling change ('anvthing') or spacing change is not reported as a difference. No second parser or normaliser.\n\"\"\"\nimport json\nimport os\nimport sys\nfrom collections import Counter\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\nsys.path.insert(0, TOOLS)\nfrom errorlist_check import class_counts, norm_ocr  # noqa: E402\n\n\n# shortcut: compares by item text only, so two same-text items at different diagram places are one class with a\n# count; upgrade to a position/uid key once Error List reads carry the object uid (today uid=None).\ndef diff(items_a, items_b):\n    \"\"\"(only_a, only_b): {class key: surplus count} for each side.\"\"\"\n    ca, cb = Counter(class_counts(items_a, ocr=True)), Counter(class_counts(items_b, ocr=True))\n    return dict(ca - cb), dict(cb - ca)\n\n\ndef label(items, key):\n    \"\"\"The first raw text in items whose class key is key (readable name for a folded key).\"\"\"\n    return next((it.get(\"raw\") for it in items if norm_ocr(it.get(\"raw\")) == key), key)\n\n\n_a = [{\"raw\": \"Wire: Wire has loose ends.\"}, {\"raw\": \"This wire is not connected to anything.\"}] * 2\n_b = [{\"raw\": \"This wire is not connected to anvthing.\"}, {\"raw\": \"Wire:Wire has loose ends.\"}]\nassert diff(_a, _b) == ({norm_ocr(_a[0][\"raw\"]): 1, norm_ocr(_a[1][\"raw\"]): 1}, {})\nassert diff([], []) == ({}, {})\nassert diff([], _b)[1] and not diff([], _b)[0]\nassert label(_b, norm_ocr(\"Wire: Wire has loose ends.\")) == \"Wire:Wire has loose ends.\"\n\nif len(sys.argv) != 3:\n    print(\"RESULT \" + json.dumps({\"ok\": False, \"why\": \"usage: el_diff.py <a.json> <b.json>\"}))\n    sys.exit(2)\npaths = sys.argv[1:]\nmissing = [p for p in paths if not os.path.isfile(p)]\nif missing:\n    print(\"RESULT \" + json.dumps({\"ok\": False, \"why\": \"missing file\", \"files\": missing}))\n    sys.exit(1)\n\nreads = [json.load(open(p, encoding=\"utf-8\")) for p in paths]\nitems = [r.get(\"items\") or [] for r in reads]\nonly = diff(items[0], items[1])\nfor side, (p, its, d) in enumerate(zip(paths, items, only)):\n    print(\"only in %s (%d of %d items):\" % (os.path.basename(p), sum(d.values()), len(its)))\n    for k, n in sorted(d.items()):\n        print(\"  %2d x %s\" % (n, label(its, k)))\n    if not d:\n        print(\"  (none)\")\nprint(\"RESULT \" + json.dumps({\n    \"ok\": True, \"n_items\": [len(i) for i in items], \"n_reported\": [r.get(\"n_reported\") for r in reads],\n    \"only_a\": {label(items[0], k): n for k, n in only[0].items()},\n    \"only_b\": {label(items[1], k): n for k, n in only[1].items()}}))\n","numLines":65,"startLine":1,"totalLines":65}}}
