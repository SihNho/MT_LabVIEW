{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MtcM65eo4qPLgkmyuxMjUy","type":"tool_result","content":"1\t# ---\n2\t# labview: none\n3\t# hardware: none\n4\t# ---\n5\tr\"\"\"el_diff - the Error List items in one stored read but not the other (OFFLINE, json only, writes nothing).\n6\tFound before writing: errorlist_check.class_counts(items, ocr=True) ({norm_ocr(raw): n}, tools/errorlist_check.py:471) is the\n7\titem key every Error List check already uses; this file CALLS it and only subtracts the two count maps.\n8\t    py tools/bench/xs_write_less/NEW_T2_r1/el_diff.py <a.json> <b.json>\"\"\"\n9\timport collections, json, os, sys                                                          # noqa: E401\n10\tsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\", \"..\")))\n11\tfrom errorlist_check import class_counts, norm_ocr                                         # noqa: E402\n12\t\n13\t\n14\tdef diff(items_a, items_b):\n15\t    \"\"\"(only_a, only_b): {class key: n} of the items in one read beyond the other, counts included, and {key: raw} for display.\"\"\"\n16\t    # shortcut: keys on the OCR-folded raw text only (vi name, row, detail ignored); upgrade if two classes share a raw text.\n17\t    ca, cb = collections.Counter(class_counts(items_a, ocr=True)), collections.Counter(class_counts(items_b, ocr=True))\n18\t    raw = {norm_ocr(it.get(\"raw\")): it.get(\"raw\") or \"\" for it in list(items_b or []) + list(items_a or [])}\n19\t    return dict(ca - cb), dict(cb - ca), raw\n20\t\n21\t\n22\t# self-check: counts matter (2 vs 1 of a class is one extra), OCR aliases fold, empty input is fine\n23\t_a = [{\"raw\": \"X: y\"}, {\"raw\": \"X: y\"}, {\"raw\": \"SubVI z\"}]\n24\t_b = [{\"raw\": \"X: y\"}, {\"raw\": \"SubVl z\"}, {\"raw\": \"W\"}]\n25\tassert diff(_a, _b)[:2] == ({\"xy\": 1}, {\"w\": 1}), diff(_a, _b)\n26\tassert diff([], [])[:2] == ({}, {})\n27\t\n28\t\n29\tdef main(pa, pb):\n30\t    a, b = (json.load(open(p, encoding=\"utf-8\")).get(\"items\") or [] for p in (pa, pb))\n31\t    only_a, only_b, raw = diff(a, b)\n32\t    for name, p, only in ((\"A\", pa, only_a), (\"B\", pb, only_b)):\n33\t        print(\"only in %s (%s): %d item(s)\" % (name, os.path.basename(p), sum(only.values())))\n34\t        for k, n in sorted(only.items()):\n35\t            print(\"  %d x %s\" % (n, raw[k] or \"(empty raw)\"))\n36\t    return {\"ok\": True, \"a_items\": len(a), \"b_items\": len(b),\n37\t            \"only_a\": sum(only_a.values()), \"only_b\": sum(only_b.values())}\n38\t\n39\t\n40\tif __name__ == \"__main__\":\n41\t    try:\n42\t        if len(sys.argv) != 3:\n43\t            raise ValueError(\"usage: el_diff.py <a.json> <b.json>\")\n44\t        r = main(sys.argv[1], sys.argv[2])\n45\t    except (OSError, ValueError) as e:\n46\t        r = {\"ok\": False, \"error\": \"%s: %s\" % (type(e).__name__, e)}\n47\t    print(\"RESULT \" + json.dumps(r))\n48\t    sys.exit(0 if r[\"ok\"] else 1)\n49\t"}]},"parent_tool_use_id":null,"session_id":"f01a795a-68db-442a-a5fd-a3e8bac13d80","uuid":"6e1f918a-3444-4568-99bb-d6a27b31a29b","timestamp":"2026-10-12T13:00:46.752Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T2\\pair1_A.py","content":"# ---\n# labview: none\n# hardware: none\n# ---\nr\"\"\"el_diff - the Error List items in one stored read but not the other (OFFLINE, json only, writes nothing).\nFound before writing: errorlist_check.class_counts(items, ocr=True) ({norm_ocr(raw): n}, tools/errorlist_check.py:471) is the\nitem key every Error List check already uses; this file CALLS it and only subtracts the two count maps.\n    py tools/bench/xs_write_less/NEW_T2_r1/el_diff.py <a.json> <b.json>\"\"\"\nimport collections, json, os, sys                                                          # noqa: E401\nsys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\", \"..\")))\nfrom errorlist_check import class_counts, norm_ocr                                         # noqa: E402\n\n\ndef diff(items_a, items_b):\n    \"\"\"(only_a, only_b): {class key: n} of the items in one read beyond the other, counts included, and {key: raw} for display.\"\"\"\n    # shortcut: keys on the OCR-folded raw text only (vi name, row, detail ignored); upgrade if two classes share a raw text.\n    ca, cb = collections.Counter(class_counts(items_a, ocr=True)), collections.Counter(class_counts(items_b, ocr=True))\n    raw = {norm_ocr(it.get(\"raw\")): it.get(\"raw\") or \"\" for it in list(items_b or []) + list(items_a or [])}\n    return dict(ca - cb), dict(cb - ca), raw\n\n\n# self-check: counts matter (2 vs 1 of a class is one extra), OCR aliases fold, empty input is fine\n_a = [{\"raw\": \"X: y\"}, {\"raw\": \"X: y\"}, {\"raw\": \"SubVI z\"}]\n_b = [{\"raw\": \"X: y\"}, {\"raw\": \"SubVl z\"}, {\"raw\": \"W\"}]\nassert diff(_a, _b)[:2] == ({\"xy\": 1}, {\"w\": 1}), diff(_a, _b)\nassert diff([], [])[:2] == ({}, {})\n\n\ndef main(pa, pb):\n    a, b = (json.load(open(p, encoding=\"utf-8\")).get(\"items\") or [] for p in (pa, pb))\n    only_a, only_b, raw = diff(a, b)\n    for name, p, only in ((\"A\", pa, only_a), (\"B\", pb, only_b)):\n        print(\"only in %s (%s): %d item(s)\" % (name, os.path.basename(p), sum(only.values())))\n        for k, n in sorted(only.items()):\n            print(\"  %d x %s\" % (n, raw[k] or \"(empty raw)\"))\n    return {\"ok\": True, \"a_items\": len(a), \"b_items\": len(b),\n            \"only_a\": sum(only_a.values()), \"only_b\": sum(only_b.values())}\n\n\nif __name__ == \"__main__\":\n    try:\n        if len(sys.argv) != 3:\n            raise ValueError(\"usage: el_diff.py <a.json> <b.json>\")\n        r = main(sys.argv[1], sys.argv[2])\n    except (OSError, ValueError) as e:\n        r = {\"ok\": False, \"error\": \"%s: %s\" % (type(e).__name__, e)}\n    print(\"RESULT \" + json.dumps(r))\n    sys.exit(0 if r[\"ok\"] else 1)\n","numLines":49,"startLine":1,"totalLines":49}}}
