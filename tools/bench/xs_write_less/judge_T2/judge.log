{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FXiRA413cQw1NW9QQf2X9v","type":"tool_result","content":"1\t# ---\n2\t# labview: none        # reads two saved Error List JSON files offline\n3\t# hardware: none\n4\t# ---\n5\t\"\"\"el_diff - items in one Error List read but not the other (multiset, keyed by errorlist_check.norm of `raw`).\n6\t\n7\t  py el_diff.py [<a.json> <b.json>]       default: the c140_3 / c141 p4s01 pair in ../inputs\n8\tPrints the items only in A, then only in B, then a RESULT {...} line.\n9\t\"\"\"\n10\timport collections, json, os, sys\n11\t\n12\tHERE = os.path.dirname(os.path.abspath(__file__))\n13\tROOT = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\", \"..\"))\n14\tsys.path.insert(0, os.path.join(ROOT, \"tools\"))\n15\timport errorlist_check as EC                                   # noqa: E402  (norm only; no LabVIEW import)\n16\t\n17\tINPUTS = os.path.join(HERE, \"..\", \"inputs\")\n18\tDEFAULT = (\"errorlist_scratch_c140_3_ring_p4s01_20261002_205117_20261002_205859.json\",\n19\t           \"errorlist_scratch_c141_p4s01_20261002_230228_20261002_230850.json\")\n20\t\n21\t\n22\tdef raws(path):\n23\t    return [it.get(\"raw\") or \"\" for it in json.load(open(path, encoding=\"utf-8\")).get(\"items\") or []]\n24\t\n25\t\n26\tdef only_in(a, b):\n27\t    \"\"\"Raws of `a` left after removing, per norm key, as many as `b` holds (multiset difference).\"\"\"\n28\t    left = collections.Counter(EC.norm(r) for r in b)\n29\t    out = []\n30\t    for r in a:\n31\t        k = EC.norm(r)\n32\t        if left[k]:\n33\t            left[k] -= 1\n34\t        else:\n35\t            out.append(r)\n36\t    return out\n37\t\n38\t\n39\tdef main():\n40\t    pa, pb = sys.argv[1:3] if len(sys.argv) >= 3 else [os.path.join(INPUTS, n) for n in DEFAULT]\n41\t    a, b = raws(pa), raws(pb)\n42\t    only_a, only_b = only_in(a, b), only_in(b, a)\n43\t    for name, path, rows in ((\"A\", pa, only_a), (\"B\", pb, only_b)):\n44\t        print(\"only in %s (%s): %d\" % (name, os.path.basename(path), len(rows)))\n45\t        for r, n in sorted(collections.Counter(rows).items()):\n46\t            print(\"  %2d x %s\" % (n, r or \"<empty raw>\"))\n47\t    print(\"RESULT \" + json.dumps({\"a\": os.path.basename(pa), \"b\": os.path.basename(pb), \"n_a\": len(a),\n48\t                                  \"n_b\": len(b), \"only_a\": len(only_a), \"only_b\": len(only_b),\n49\t                                  \"identical\": not only_a and not only_b}))\n50\t\n51\t\n52\tif __name__ == \"__main__\":\n53\t    main()\n54\t"}]},"parent_tool_use_id":null,"session_id":"f01a795a-68db-442a-a5fd-a3e8bac13d80","uuid":"42779fe7-f217-435e-a591-2a932ef3c7f7","timestamp":"2026-10-12T13:00:47.548Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T2\\pair1_B.py","content":"# ---\n# labview: none        # reads two saved Error List JSON files offline\n# hardware: none\n# ---\n\"\"\"el_diff - items in one Error List read but not the other (multiset, keyed by errorlist_check.norm of `raw`).\n\n  py el_diff.py [<a.json> <b.json>]       default: the c140_3 / c141 p4s01 pair in ../inputs\nPrints the items only in A, then only in B, then a RESULT {...} line.\n\"\"\"\nimport collections, json, os, sys\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nROOT = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\", \"..\"))\nsys.path.insert(0, os.path.join(ROOT, \"tools\"))\nimport errorlist_check as EC                                   # noqa: E402  (norm only; no LabVIEW import)\n\nINPUTS = os.path.join(HERE, \"..\", \"inputs\")\nDEFAULT = (\"errorlist_scratch_c140_3_ring_p4s01_20261002_205117_20261002_205859.json\",\n           \"errorlist_scratch_c141_p4s01_20261002_230228_20261002_230850.json\")\n\n\ndef raws(path):\n    return [it.get(\"raw\") or \"\" for it in json.load(open(path, encoding=\"utf-8\")).get(\"items\") or []]\n\n\ndef only_in(a, b):\n    \"\"\"Raws of `a` left after removing, per norm key, as many as `b` holds (multiset difference).\"\"\"\n    left = collections.Counter(EC.norm(r) for r in b)\n    out = []\n    for r in a:\n        k = EC.norm(r)\n        if left[k]:\n            left[k] -= 1\n        else:\n            out.append(r)\n    return out\n\n\ndef main():\n    pa, pb = sys.argv[1:3] if len(sys.argv) >= 3 else [os.path.join(INPUTS, n) for n in DEFAULT]\n    a, b = raws(pa), raws(pb)\n    only_a, only_b = only_in(a, b), only_in(b, a)\n    for name, path, rows in ((\"A\", pa, only_a), (\"B\", pb, only_b)):\n        print(\"only in %s (%s): %d\" % (name, os.path.basename(path), len(rows)))\n        for r, n in sorted(collections.Counter(rows).items()):\n            print(\"  %2d x %s\" % (n, r or \"<empty raw>\"))\n    print(\"RESULT \" + json.dumps({\"a\": os.path.basename(pa), \"b\": os.path.basename(pb), \"n_a\": len(a),\n                                  \"n_b\": len(b), \"only_a\": len(only_a), \"only_b\": len(only_b),\n                                  \"identical\": not only_a and not only_b}))\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":54,"startLine":1,"totalLines":54}}}
