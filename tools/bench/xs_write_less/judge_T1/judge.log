{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KekqTsaQnDKc8xjCwkEbM9","type":"tool_result","content":"1\t# ---\n2\t# labview: none\n3\t# hardware: none\n4\t# ---\n5\t\"\"\"count_gate_fp - number of OPEN gate false positives per gate class, read from the bench input copy of the queue.\n6\t\n7\tGate class = the hook name for a guard (suffixes like `.undisposed` or `:c-outside-purpose` dropped), or\n8\t`checker:<tool>` for a checker gate. Reading the queue is gate_fp.read_queue (shared, not re-written here).\n9\t\"\"\"\n10\timport collections\n11\timport json\n12\timport os\n13\timport sys\n14\t\n15\tHERE = os.path.dirname(os.path.abspath(__file__))\n16\tTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\n17\tsys.path.insert(0, TOOLS)\n18\timport gate_fp  # noqa: E402\n19\t\n20\tQUEUE = os.path.join(HERE, \"..\", \"inputs\", \"gate_fp_queue.jsonl\")\n21\t\n22\t\n23\tdef gate_class(gate):\n24\t    parts = (gate or \"?\").split(\".\")[0].split(\":\")\n25\t    return \":\".join(parts[:2]) if parts[0] == \"checker\" else parts[0]\n26\t\n27\t\n28\trows = gate_fp.read_queue(QUEUE)\n29\topen_rows = [r for r in rows if r.get(\"status\") == \"open\"]\n30\tcounts = collections.Counter(gate_class(r.get(\"gate\")) for r in open_rows)\n31\tfor cls, n in counts.most_common():\n32\t    print(\"%-28s %d\" % (cls, n))\n33\tprint(\"RESULT \" + json.dumps({\"rows\": len(rows), \"open\": len(open_rows), \"per_class\": dict(counts.most_common())}))\n34\t"}]},"parent_tool_use_id":null,"session_id":"4912eeea-8a09-4215-a0e9-f80853a166b5","uuid":"172a382c-e4ef-4226-9383-5f3d1d264be3","timestamp":"2026-10-12T12:49:03.336Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T1\\pair2_B.py","content":"# ---\n# labview: none\n# hardware: none\n# ---\n\"\"\"count_gate_fp - number of OPEN gate false positives per gate class, read from the bench input copy of the queue.\n\nGate class = the hook name for a guard (suffixes like `.undisposed` or `:c-outside-purpose` dropped), or\n`checker:<tool>` for a checker gate. Reading the queue is gate_fp.read_queue (shared, not re-written here).\n\"\"\"\nimport collections\nimport json\nimport os\nimport sys\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\nsys.path.insert(0, TOOLS)\nimport gate_fp  # noqa: E402\n\nQUEUE = os.path.join(HERE, \"..\", \"inputs\", \"gate_fp_queue.jsonl\")\n\n\ndef gate_class(gate):\n    parts = (gate or \"?\").split(\".\")[0].split(\":\")\n    return \":\".join(parts[:2]) if parts[0] == \"checker\" else parts[0]\n\n\nrows = gate_fp.read_queue(QUEUE)\nopen_rows = [r for r in rows if r.get(\"status\") == \"open\"]\ncounts = collections.Counter(gate_class(r.get(\"gate\")) for r in open_rows)\nfor cls, n in counts.most_common():\n    print(\"%-28s %d\" % (cls, n))\nprint(\"RESULT \" + json.dumps({\"rows\": len(rows), \"open\": len(open_rows), \"per_class\": dict(counts.most_common())}))\n","numLines":34,"startLine":1,"totalLines":34}}}
