{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MjmYNPVVF99DksWscLpSsj","type":"tool_result","content":"1\t# ---\n2\t# labview: none\n3\t# hardware: none\n4\t# ---\n5\t\"\"\"count_gate_fp.py - number of OPEN gate-fp queue entries per gate class, then a RESULT line.\n6\t\n7\tGate class: `checker:<tool>` for a checker gate, else the hook name (`guard_peer.undisposed`, `guard_assign:x` ->\n8\t`guard_peer`, `guard_assign`). Reads the queue with gate_fp.read_queue (no second parser).\n9\t\"\"\"\n10\timport json\n11\timport os\n12\timport sys\n13\tfrom collections import Counter\n14\t\n15\tHERE = os.path.dirname(os.path.abspath(__file__))\n16\tTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\n17\tsys.path.insert(0, TOOLS)\n18\timport gate_fp  # noqa: E402\n19\t\n20\tQUEUE = os.path.join(HERE, \"..\", \"inputs\", \"gate_fp_queue.jsonl\")\n21\t\n22\t\n23\tdef gate_class(gate):\n24\t    parts = (gate or \"?\").split(\":\")\n25\t    if parts[0] == \"checker\" and len(parts) > 1:\n26\t        return \"checker:\" + parts[1]\n27\t    return parts[0].split(\".\")[0]\n28\t\n29\t\n30\tassert gate_class(\"checker:stagekit:PB\") == \"checker:stagekit\"\n31\tassert gate_class(\"guard_peer.undisposed\") == \"guard_peer\"\n32\tassert gate_class(\"guard_assign:c-outside-purpose\") == \"guard_assign\"\n33\tassert gate_class(\"guard_bash\") == \"guard_bash\"\n34\tassert gate_class(None) == \"?\"\n35\t\n36\t# read_queue returns [] for a missing file; say so instead of printing zero counts.\n37\tif not os.path.isfile(QUEUE):\n38\t    print('RESULT ' + json.dumps({\"ok\": False, \"why\": \"missing \" + QUEUE}))\n39\t    sys.exit(1)\n40\t\n41\tcounts = Counter(gate_class(r.get(\"gate\")) for r in gate_fp.read_queue(QUEUE) if r.get(\"status\") == \"open\")\n42\tfor cls, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):\n43\t    print(\"%3d  %s\" % (n, cls))\n44\tprint(\"RESULT \" + json.dumps({\"ok\": True, \"open\": sum(counts.values()), \"by_class\": dict(counts)}))\n45\t"}]},"parent_tool_use_id":null,"session_id":"4912eeea-8a09-4215-a0e9-f80853a166b5","uuid":"a5b2b086-c4b2-40ab-8739-2b5d12243500","timestamp":"2026-10-12T12:49:01.732Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T1\\pair1_B.py","content":"# ---\n# labview: none\n# hardware: none\n# ---\n\"\"\"count_gate_fp.py - number of OPEN gate-fp queue entries per gate class, then a RESULT line.\n\nGate class: `checker:<tool>` for a checker gate, else the hook name (`guard_peer.undisposed`, `guard_assign:x` ->\n`guard_peer`, `guard_assign`). Reads the queue with gate_fp.read_queue (no second parser).\n\"\"\"\nimport json\nimport os\nimport sys\nfrom collections import Counter\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\nsys.path.insert(0, TOOLS)\nimport gate_fp  # noqa: E402\n\nQUEUE = os.path.join(HERE, \"..\", \"inputs\", \"gate_fp_queue.jsonl\")\n\n\ndef gate_class(gate):\n    parts = (gate or \"?\").split(\":\")\n    if parts[0] == \"checker\" and len(parts) > 1:\n        return \"checker:\" + parts[1]\n    return parts[0].split(\".\")[0]\n\n\nassert gate_class(\"checker:stagekit:PB\") == \"checker:stagekit\"\nassert gate_class(\"guard_peer.undisposed\") == \"guard_peer\"\nassert gate_class(\"guard_assign:c-outside-purpose\") == \"guard_assign\"\nassert gate_class(\"guard_bash\") == \"guard_bash\"\nassert gate_class(None) == \"?\"\n\n# read_queue returns [] for a missing file; say so instead of printing zero counts.\nif not os.path.isfile(QUEUE):\n    print('RESULT ' + json.dumps({\"ok\": False, \"why\": \"missing \" + QUEUE}))\n    sys.exit(1)\n\ncounts = Counter(gate_class(r.get(\"gate\")) for r in gate_fp.read_queue(QUEUE) if r.get(\"status\") == \"open\")\nfor cls, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):\n    print(\"%3d  %s\" % (n, cls))\nprint(\"RESULT \" + json.dumps({\"ok\": True, \"open\": sum(counts.values()), \"by_class\": dict(counts)}))\n","numLines":45,"startLine":1,"totalLines":45}}}
