join(HERE, \"..\", \"inputs\")\nDEFAULT = (\"errorlist_scratch_c140_3_ring_p4s01_20261002_205117_20261002_205859.json\",\n           \"errorlist_scratch_c141_p4s01_20261002_230228_20261002_230850.json\")\n\n\ndef main():\n    paths = sys.argv[1:3] if len(sys.argv) >= 3 else [os.path.join(INPUTS, f) for f in DEFAULT]\n    items = [json.load(open(p, encoding=\"utf-8\")).get(\"items\") or [] for p in paths]\n    counts = [class_counts(x, ocr=True) for x in items]\n    shown = {}                                                     # key -> the first raw text read for it\n    for it in items[0] + items[1]:\n        shown.setdefault(norm_ocr(it.get(\"raw\")), it.get(\"raw\"))\n    only = []\n    for side, (mine, other) in enumerate([(counts[0], counts[1]), (counts[1], counts[0])]):\n        name = os.path.basename(paths[side])\n        rows = [(k, mine[k] - other.get(k, 0)) for k in mine if mine[k] > other.get(k, 0)]\n        print(\"ONLY IN %s (%d items of %d):\" % (name, sum(n for _, n in rows), len(items[side])))\n        for k, n in rows:\n            print(\"  %dx %r\" % (n, shown[k]))\n        only.append(sum(n for _, n in rows))\n    print(\"RESULT \" + json.dumps({\"a\": os.path.basename(paths[0]), \"b\": os.path.basename(paths[1]),\n                                  \"items_a\": len(items[0]), \"items_b\": len(items[1]),\n                                  \"only_a\": only[0], \"only_b\": only[1], \"ok\": True}))\n\n\nif __name__ == \"__main__\":\n    main()\n"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":14,"subtype":"success","api_error_status":null,"result":"I didn't write or run `el_di