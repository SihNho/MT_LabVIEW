{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfxPAcpgjEmutptjd25bN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014MnsKcnFMh8gA99dGbSFCG","name":"Write","input":{"file_path":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\OLD_T2_r1\\el_diff.py","content":"# labview: none (reads two saved Error List JSON files offline)\n# hardware: none\n\"\"\"el_diff - items in one Error List read but not the other (multiset, keyed by errorlist_check.norm of `raw`).\n\n  py el_diff.py [<a.json> <b.json>]       default: the c140_3 / c141 p4s01 pair in ../inputs\nPrints the items only in A, then only in B, then a RESULT {...} line.\n\"\"\"\nimport collections, json, os, sys\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nROOT = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\", \"..\"))\nsys.path.insert(0, os.path.join(ROOT, \"tools\"))\nimport errorlist_check as EC                                   # noqa: E402  (norm only; no LabVIEW import)\n\nINPUTS = os.path.join(HERE, \"..\", \"inputs\")\nDEFAULT = (\"errorlist_scratch_c140_3_ring_p4s01_20261002_205117_20261002_205859.json\",\n           \"errorlist_scratch_c141_p4s01_20261002_230228_20261002_230850.json\")\n\n\ndef raws(path):\n    return [it.get(\"raw\") or \"\" for it in json.load(open(path, encoding=\"utf-8\")).get(\"items\") or []]\n\n\ndef only_in(a, b):\n    \"\"\"Raws of `a` left after removing, per norm key, as many as `b` holds (multiset difference).\"\"\"\n    left = collections.Counter(EC.norm(r) for r in b)\n    out = []\n    for r in a:\n        k = EC.norm(r)\n        if left[k]:\n            left[k] -= 1\n        else:\n            out.append(r)\n    return out\n\n\ndef main():\n    pa, pb = sys.argv[1:3] if len(sys.argv) >= 3 else [os.path.join(INPUTS, n) for n in DEFAULT]\n    a, b = raws(pa), raws(pb)\n    only_a, only_b = only_in(a, b), only_in(b, a)\n    for name, path, rows in ((\"A\", pa, only_a), (\"B\", pb, only_b)):\n        print(\"only in %s (%s): %d\" % (name, os.path.basename(path), len(rows)))\n        for r, n in sorted(collections.Counter(rows).items()):\n            print(\"  %2d x %s\" % (n, r or \"<empty raw>\"))\n    print(\"RESULT \" + json.dumps({\"a\": os.path.basename(pa), \"b\": os.path.basename(pb), \"n_a\": len(a),\n                                  \"n_b\": len(b), \"only_a\": len(only_a), \"only_b\": len(only_b),\n                                  \"identical\": not only_a and not only_b}))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1671,"cache_read_input_tokens":68688,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1671},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"be8b9dd8-dea4-4521-81a5-108b187601c5","uuid":"4c12f9ed-34c3-4ad4-8f38-e9dc547b783e","timestamp":"2026-10-12T12:59:03.237Z","request_id":"req_011CfxPAcWZwrDNrtrP8nWr6","wire_tool_inputs":{"toolu_014MnsKcnFMh8gA99dGbSFCG":{"file_path":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\OLD_T2_r1\\el_diff.py","content":"# labview: none (reads two saved Error List JSON files offline)\n# hardware: none\n\"\"\"el_diff - items in one Error List read but not the other (multiset, keyed by errorlist_check.norm of `raw`).\n\n  py el_diff.py [<a.json> <b.json>]       default: the c140_3 / c141 p4s01 pair in ../inputs\nPrints the items only in A, then only in B, then a RESULT {...} line.\n\"\"\"\nimport collections, json, os, sys\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nROOT = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\", \"..\"))\nsys.path.insert(0, os.path.join(ROOT, \"tools\"))\nimport errorlist_check as EC                                   # noqa: E402  (norm only; no LabVIEW import)\n\nINPUTS = os.path.join(HERE, \"..\", \"inputs\")\nDEFAULT = (\"errorlist_scratch_c140_3_ring_p4s01_20261002_205117_20261002_205859.json\",\n           \"errorlist_scratch_c141_p4s01_20261002_230228_20261002_230850.json\")\n\n\ndef raws(path):\n    return [it.get(\"raw\") or \"\" for it in json.load(open(path, encoding=\"utf-8\")).get(\"items\") or []]\n\n\ndef only_in(a, b):\n    \"\"\"Raws of `a` left after removing, per norm key, as many as `b` holds (multiset difference).\"\"\"\n    left = collections.Counter(EC.norm(r) for r in b)\n    out = []\n    for r in a:\n        k = EC.norm(r)\n        if left[k]:\n            left[k] -= 1\n        else:\n            out.append(r)\n    return out\n\n\ndef main():\n    pa, pb = sys.argv[1:3] if len(sys.argv) >= 3 else [os.path.join(INPUTS, n) for n in DEFAULT]\n    a, b = raws(pa), raws(pb)\n    only_a, only_b = only_in(a, b), only_in(b, a)\n    for name, path, rows in ((\"A\", pa, only_a), (\"B\", pb, only_b)):\n        print(\"only in %s (%s): %d\" % (name, os.path.basename(path), len(rows)))\n        for r, n in sorted(collections.Counter(rows).items()):\n            print(\"  %2d x %s\" % (n, r or \"<empty raw>\"))\n    print(\"RESULT \" + json.dumps({\"a\": os.path.basename(pa), \"b\": os.path.basename(pb), \"n_a\": len(a),\n                                  \"n_b\": len(b), \"only_a\": len(only_a), \"only_b\": len(only_b),\n                                  \"identical\": not only_a and not only_b}))\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
