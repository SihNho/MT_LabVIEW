{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FjniszmQyu1Vtyc7PEBL7h","type":"tool_result","content":"1\t# ---\n2\t# labview: none\n3\t# hardware: none\n4\t# ---\n5\t\"\"\"Per cycle of inputs/cycle_runner.log: its cost and the outcome of each assignment round (PURPOSE_MET / HANDBACK).\n6\t\n7\tCost = debate_loop._cost_of over that cycle's CYCLE lines (called, not copied): a cycle number logged more than once\n8\t(re-run, restart) sums its priced lines; a line with no `$` (killed, usage limit) adds nothing.\n9\tUsage: py cycle_costs.py\n10\t\"\"\"\n11\timport json\n12\timport os\n13\timport re\n14\timport sys\n15\t\n16\tHERE = os.path.dirname(os.path.abspath(__file__))\n17\tTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\n18\tLOG = os.path.join(HERE, \"..\", \"inputs\", \"cycle_runner.log\")\n19\tsys.path.insert(0, TOOLS)\n20\tfrom debate_loop import _cost_of  # noqa: E402\n21\t\n22\tCYCLE_RX = re.compile(r\"^CYCLE (\\d+) \\|\")\n23\tROUND_END_RX = re.compile(r\"^ASSIGN \\|[^|]*\\| cycle (\\d+) round (\\d+) \\| end [^|]*\\|[^|]*\\|[^|]*\\|[^|]*\\| (PURPOSE_MET|HANDBACK)\\b\")\n24\t\n25\t\n26\tdef parse(lines):\n27\t    \"\"\"{cycle: {\"lines\": [CYCLE lines], \"rounds\": [(round, outcome), ...]}} in log order.\"\"\"\n28\t    cycles = {}\n29\t    for ln in lines:\n30\t        m = CYCLE_RX.match(ln)\n31\t        if m:\n32\t            cycles.setdefault(int(m.group(1)), {\"lines\": [], \"rounds\": []})[\"lines\"].append(ln)\n33\t            continue\n34\t        m = ROUND_END_RX.match(ln)\n35\t        if m:\n36\t            cycles.setdefault(int(m.group(1)), {\"lines\": [], \"rounds\": []})[\"rounds\"].append((int(m.group(2)), m.group(3)))\n37\t    return cycles\n38\t\n39\t\n40\tdef selfcheck():\n41\t    sample = [\n42\t        \"CYCLE 9 | a | b | KILLED by the user's order | non-result, void | x\",\n43\t        \"CYCLE 9 | a | b | exit 0 | $1.5000 | x\",\n44\t        \"CYCLE 9 | a | b | exit 0 | $2.2500 | x\",\n45\t        \"ASSIGN | t | cycle 9 round 1 | start claude/high | f.json\",\n46\t        \"ASSIGN | t | cycle 9 round 1 | end exit 0 | $1.0 | 2 min | 0 card(s) | HANDBACK (session) | why\",\n47\t        \"ASSIGN | t | cycle 9 round 2 | end exit 0 | $1.0 | 2 min | 1 card(s) | PURPOSE_MET | ok\",\n48\t    ]\n49\t    c = parse(sample)\n50\t    assert list(c) == [9], c\n51\t    assert abs(_cost_of(c[9][\"lines\"]) - 3.75) < 1e-9, c\n52\t    assert c[9][\"rounds\"] == [(1, \"HANDBACK\"), (2, \"PURPOSE_MET\")], c\n53\t    assert parse([]) == {}\n54\t\n55\t\n56\tdef main():\n57\t    selfcheck()\n58\t    with open(LOG, encoding=\"utf-8\", errors=\"replace\") as f:\n59\t        cycles = parse(f.read().splitlines())\n60\t    total, n_met, n_hb = 0.0, 0, 0\n61\t    for n in sorted(cycles):\n62\t        cost = _cost_of(cycles[n][\"lines\"])\n63\t        rounds = cycles[n][\"rounds\"]\n64\t        total += cost\n65\t        n_met += sum(1 for _, o in rounds if o == \"PURPOSE_MET\")\n66\t        n_hb += sum(1 for _, o in rounds if o == \"HANDBACK\")\n67\t        shown = \" \".join(\"r%d=%s\" % r for r in rounds) or \"-\"\n68\t        print(\"cycle %4d  $%8.4f  rounds: %s\" % (n, cost, shown))\n69\t    print(\"RESULT \" + json.dumps({\"ok\": True, \"cycles\": len(cycles), \"total_usd\": round(total, 4),\n70\t                                  \"rounds\": n_met + n_hb, \"purpose_met\": n_met, \"handback\": n_hb}))\n71\t\n72\t\n73\tif __name__ == \"__main__\":\n74\t    main()\n75\t"}]},"parent_tool_use_id":null,"session_id":"6552092b-1c40-4ea8-a329-f9bfabea7f93","uuid":"36a90086-a086-4e26-a43d-b8b2c293edd0","timestamp":"2026-10-12T13:00:47.432Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T3\\pair1_B.py","content":"# ---\n# labview: none\n# hardware: none\n# ---\n\"\"\"Per cycle of inputs/cycle_runner.log: its cost and the outcome of each assignment round (PURPOSE_MET / HANDBACK).\n\nCost = debate_loop._cost_of over that cycle's CYCLE lines (called, not copied): a cycle number logged more than once\n(re-run, restart) sums its priced lines; a line with no `$` (killed, usage limit) adds nothing.\nUsage: py cycle_costs.py\n\"\"\"\nimport json\nimport os\nimport re\nimport sys\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nTOOLS = os.path.abspath(os.path.join(HERE, \"..\", \"..\", \"..\"))\nLOG = os.path.join(HERE, \"..\", \"inputs\", \"cycle_runner.log\")\nsys.path.insert(0, TOOLS)\nfrom debate_loop import _cost_of  # noqa: E402\n\nCYCLE_RX = re.compile(r\"^CYCLE (\\d+) \\|\")\nROUND_END_RX = re.compile(r\"^ASSIGN \\|[^|]*\\| cycle (\\d+) round (\\d+) \\| end [^|]*\\|[^|]*\\|[^|]*\\|[^|]*\\| (PURPOSE_MET|HANDBACK)\\b\")\n\n\ndef parse(lines):\n    \"\"\"{cycle: {\"lines\": [CYCLE lines], \"rounds\": [(round, outcome), ...]}} in log order.\"\"\"\n    cycles = {}\n    for ln in lines:\n        m = CYCLE_RX.match(ln)\n        if m:\n            cycles.setdefault(int(m.group(1)), {\"lines\": [], \"rounds\": []})[\"lines\"].append(ln)\n            continue\n        m = ROUND_END_RX.match(ln)\n        if m:\n            cycles.setdefault(int(m.group(1)), {\"lines\": [], \"rounds\": []})[\"rounds\"].append((int(m.group(2)), m.group(3)))\n    return cycles\n\n\ndef selfcheck():\n    sample = [\n        \"CYCLE 9 | a | b | KILLED by the user's order | non-result, void | x\",\n        \"CYCLE 9 | a | b | exit 0 | $1.5000 | x\",\n        \"CYCLE 9 | a | b | exit 0 | $2.2500 | x\",\n        \"ASSIGN | t | cycle 9 round 1 | start claude/high | f.json\",\n        \"ASSIGN | t | cycle 9 round 1 | end exit 0 | $1.0 | 2 min | 0 card(s) | HANDBACK (session) | why\",\n        \"ASSIGN | t | cycle 9 round 2 | end exit 0 | $1.0 | 2 min | 1 card(s) | PURPOSE_MET | ok\",\n    ]\n    c = parse(sample)\n    assert list(c) == [9], c\n    assert abs(_cost_of(c[9][\"lines\"]) - 3.75) < 1e-9, c\n    assert c[9][\"rounds\"] == [(1, \"HANDBACK\"), (2, \"PURPOSE_MET\")], c\n    assert parse([]) == {}\n\n\ndef main():\n    selfcheck()\n    with open(LOG, encoding=\"utf-8\", errors=\"replace\") as f:\n        cycles = parse(f.read().splitlines())\n    total, n_met, n_hb = 0.0, 0, 0\n    for n in sorted(cycles):\n        cost = _cost_of(cycles[n][\"lines\"])\n        rounds = cycles[n][\"rounds\"]\n        total += cost\n        n_met += sum(1 for _, o in rounds if o == \"PURPOSE_MET\")\n        n_hb += sum(1 for _, o in rounds if o == \"HANDBACK\")\n        shown = \" \".join(\"r%d=%s\" % r for r in rounds) or \"-\"\n        print(\"cycle %4d  $%8.4f  rounds: %s\" % (n, cost, shown))\n    print(\"RESULT \" + json.dumps({\"ok\": True, \"cycles\": len(cycles), \"total_usd\": round(total, 4),\n                                  \"rounds\": n_met + n_hb, \"purpose_met\": n_met, \"handback\": n_hb}))\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":75,"startLine":1,"totalLines":75}}}
