{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PVFKvmDhzcXAGgyr2mWE8i","type":"tool_result","content":"1\t# ---\n2\t# labview: none\n3\t# hardware: none\n4\t# ---\n5\t\"\"\"Per cycle of tools/bench/xs_write_less/inputs/cycle_runner.log: the runner's cost (the CYCLE line's $) and how\n6\teach assignment round ended (PURPOSE_MET / HANDBACK, from the ASSIGN ... end lines). Ends with a RESULT {...} line.\n7\t\n8\tLine formats come from tools/bench/livebench/lb_collect.py (CYCLE_RE, ASSIGN_END_RE), imported, not copied.\n9\tlb_collect.runner_section() does this walk too but reads <wt>/tools/bench/cycle_runner.log only, so it cannot be\n10\tpointed at the inputs/ copy; this script walks the lines itself with the same regexes.\n11\t\"\"\"\n12\timport json\n13\timport os\n14\timport re\n15\timport sys\n16\t\n17\tREPO = os.path.abspath(os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"..\", \"..\"))\n18\tLOG = os.path.join(REPO, \"tools\", \"bench\", \"xs_write_less\", \"inputs\", \"cycle_runner.log\")\n19\tsys.path.insert(0, os.path.join(REPO, \"tools\", \"bench\", \"livebench\"))\n20\tfrom lb_collect import ASSIGN_END_RE, CYCLE_RE  # noqa: E402\n21\t\n22\t# Any CYCLE line, including the ones CYCLE_RE skips (usage-limit retries, KILLED, orphaned 'exit ?'), so such a\n23\t# cycle is still listed, with an unknown cost, instead of vanishing.\n24\tANY_CYCLE_RE = re.compile(r\"^CYCLE (\\d+) \\|\")\n25\t\n26\t\n27\tdef parse(lines):\n28\t    \"\"\"-> {cycle: {\"usd\": float|None, \"rounds\": [(round, outcome), ...]}}; the last priced CYCLE line wins.\"\"\"\n29\t    cycles = {}\n30\t    for ln in lines:\n31\t        m = CYCLE_RE.match(ln)\n32\t        if m:\n33\t            c = cycles.setdefault(int(m.group(1)), {\"usd\": None, \"rounds\": []})\n34\t            c[\"usd\"] = None if m.group(5) == \"?\" else float(m.group(5)[1:])\n35\t            continue\n36\t        m = ANY_CYCLE_RE.match(ln)\n37\t        if m:\n38\t            cycles.setdefault(int(m.group(1)), {\"usd\": None, \"rounds\": []})\n39\t            continue\n40\t        m = ASSIGN_END_RE.match(ln)\n41\t        if m:\n42\t            c = cycles.setdefault(int(m.group(2)), {\"usd\": None, \"rounds\": []})\n43\t            c[\"rounds\"].append((int(m.group(3)), m.group(8)))\n44\t    return cycles\n45\t\n46\t\n47\tdef selfcheck():\n48\t    sample = [\n49\t        \"CYCLE 62 | 2026-09-22 10:00:20 | 2026-09-22 10:03:43 | usage-limit attempt 1, non-result; sleeping\",\n50\t        \"CYCLE 62 | 2026-09-22 10:18:45 | 2026-09-22 11:26:40 | exit 0 | $30.0875 | text\",\n51\t        \"CYCLE 141 | 2026-10-02 21:56:06 | 2026-10-03 00:11:05 | exit ? (orphaned) | $? | motor-end OK\",\n52\t        \"ASSIGN | 2026-10-07 20:22:37 | cycle 144 round 1 | end exit 0 | $13.0819 | 28 min | 4 card(s) | \"\n53\t        \"HANDBACK (session) | detail\",\n54\t        \"ASSIGN | 2026-10-07 21:13:45 | cycle 144 round 2 | end exit 0 | $15.0886 | 47 min | 3 card(s) | \"\n55\t        \"PURPOSE_MET | all 6 pass item(s) met with evidence\",\n56\t        \"ASSIGN | 2026-10-07 20:27:08 | cycle 144 round 2 | start claude-sonnet-5-5/high, caps 180 min | x.json\",\n57\t    ]\n58\t    got = parse(sample)\n59\t    assert got[62] == {\"usd\": 30.0875, \"rounds\": []}, got[62]\n60\t    assert got[141] == {\"usd\": None, \"rounds\": []}, got[141]\n61\t    assert got[144] == {\"usd\": None, \"rounds\": [(1, \"HANDBACK\"), (2, \"PURPOSE_MET\")]}, got[144]\n62\t    assert parse([]) == {}\n63\t\n64\t\n65\tdef main():\n66\t    selfcheck()\n67\t    if not os.path.isfile(LOG):\n68\t        print(\"RESULT \" + json.dumps({\"ok\": False, \"error\": \"missing \" + LOG}))\n69\t        return 1\n70\t    with open(LOG, encoding=\"utf-8\", errors=\"replace\") as f:\n71\t        cycles = parse(f.read().splitlines())\n72\t\n73\t    for n in sorted(cycles):\n74\t        c = cycles[n]\n75\t        cost = \"$?\" if c[\"usd\"] is None else \"$%.4f\" % c[\"usd\"]\n76\t        if c[\"rounds\"]:\n77\t            ended = \"ended %s (rounds: %s)\" % (c[\"rounds\"][-1][1], \", \".join(\"r%d %s\" % r for r in c[\"rounds\"]))\n78\t        else:\n79\t            ended = \"no assignment rounds\"\n80\t        print(\"cycle %3d  %9s  %s\" % (n, cost, ended))\n81\t\n82\t    with_rounds = [c for c in cycles.values() if c[\"rounds\"]]\n83\t    all_rounds = [o for c in with_rounds for _, o in c[\"rounds\"]]\n84\t    print(\"RESULT \" + json.dumps({\n85\t        \"ok\": True,\n86\t        \"cycles\": len(cycles),\n87\t        \"total_usd\": round(sum(c[\"usd\"] for c in cycles.values() if c[\"usd\"] is not None), 4),\n88\t        \"unpriced_cycles\": sorted(n for n, c in cycles.items() if c[\"usd\"] is None),\n89\t        \"cycles_with_rounds\": len(with_rounds),\n90\t        \"cycles_ended_purpose_met\": sum(c[\"rounds\"][-1][1] == \"PURPOSE_MET\" for c in with_rounds),\n91\t        \"cycles_ended_handback\": sum(c[\"rounds\"][-1][1] == \"HANDBACK\" for c in with_rounds),\n92\t        \"rounds_purpose_met\": all_rounds.count(\"PURPOSE_MET\"),\n93\t        \"rounds_handback\": all_rounds.count(\"HANDBACK\"),\n94\t    }))\n95\t    return 0\n96\t\n97\t\n98\tif __name__ == \"__main__\":\n99\t    sys.exit(main())\n100\t"}]},"parent_tool_use_id":null,"session_id":"6552092b-1c40-4ea8-a329-f9bfabea7f93","uuid":"b5d355ab-c713-4a9a-aa1a-781838b2c25f","timestamp":"2026-10-12T13:00:49.154Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\bench\\xs_write_less\\judge_T3\\pair2_B.py","content":"# ---\n# labview: none\n# hardware: none\n# ---\n\"\"\"Per cycle of tools/bench/xs_write_less/inputs/cycle_runner.log: the runner's cost (the CYCLE line's $) and how\neach assignment round ended (PURPOSE_MET / HANDBACK, from the ASSIGN ... end lines). Ends with a RESULT {...} line.\n\nLine formats come from tools/bench/livebench/lb_collect.py (CYCLE_RE, ASSIGN_END_RE), imported, not copied.\nlb_collect.runner_section() does this walk too but reads <wt>/tools/bench/cycle_runner.log only, so it cannot be\npointed at the inputs/ copy; this script walks the lines itself with the same regexes.\n\"\"\"\nimport json\nimport os\nimport re\nimport sys\n\nREPO = os.path.abspath(os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"..\", \"..\"))\nLOG = os.path.join(REPO, \"tools\", \"bench\", \"xs_write_less\", \"inputs\", \"cycle_runner.log\")\nsys.path.insert(0, os.path.join(REPO, \"tools\", \"bench\", \"livebench\"))\nfrom lb_collect import ASSIGN_END_RE, CYCLE_RE  # noqa: E402\n\n# Any CYCLE line, including the ones CYCLE_RE skips (usage-limit retries, KILLED, orphaned 'exit ?'), so such a\n# cycle is still listed, with an unknown cost, instead of vanishing.\nANY_CYCLE_RE = re.compile(r\"^CYCLE (\\d+) \\|\")\n\n\ndef parse(lines):\n    \"\"\"-> {cycle: {\"usd\": float|None, \"rounds\": [(round, outcome), ...]}}; the last priced CYCLE line wins.\"\"\"\n    cycles = {}\n    for ln in lines:\n        m = CYCLE_RE.match(ln)\n        if m:\n            c = cycles.setdefault(int(m.group(1)), {\"usd\": None, \"rounds\": []})\n            c[\"usd\"] = None if m.group(5) == \"?\" else float(m.group(5)[1:])\n            continue\n        m = ANY_CYCLE_RE.match(ln)\n        if m:\n            cycles.setdefault(int(m.group(1)), {\"usd\": None, \"rounds\": []})\n            continue\n        m = ASSIGN_END_RE.match(ln)\n        if m:\n            c = cycles.setdefault(int(m.group(2)), {\"usd\": None, \"rounds\": []})\n            c[\"rounds\"].append((int(m.group(3)), m.group(8)))\n    return cycles\n\n\ndef selfcheck():\n    sample = [\n        \"CYCLE 62 | 2026-09-22 10:00:20 | 2026-09-22 10:03:43 | usage-limit attempt 1, non-result; sleeping\",\n        \"CYCLE 62 | 2026-09-22 10:18:45 | 2026-09-22 11:26:40 | exit 0 | $30.0875 | text\",\n        \"CYCLE 141 | 2026-10-02 21:56:06 | 2026-10-03 00:11:05 | exit ? (orphaned) | $? | motor-end OK\",\n        \"ASSIGN | 2026-10-07 20:22:37 | cycle 144 round 1 | end exit 0 | $13.0819 | 28 min | 4 card(s) | \"\n        \"HANDBACK (session) | detail\",\n        \"ASSIGN | 2026-10-07 21:13:45 | cycle 144 round 2 | end exit 0 | $15.0886 | 47 min | 3 card(s) | \"\n        \"PURPOSE_MET | all 6 pass item(s) met with evidence\",\n        \"ASSIGN | 2026-10-07 20:27:08 | cycle 144 round 2 | start claude-sonnet-5-5/high, caps 180 min | x.json\",\n    ]\n    got = parse(sample)\n    assert got[62] == {\"usd\": 30.0875, \"rounds\": []}, got[62]\n    assert got[141] == {\"usd\": None, \"rounds\": []}, got[141]\n    assert got[144] == {\"usd\": None, \"rounds\": [(1, \"HANDBACK\"), (2, \"PURPOSE_MET\")]}, got[144]\n    assert parse([]) == {}\n\n\ndef main():\n    selfcheck()\n    if not os.path.isfile(LOG):\n        print(\"RESULT \" + json.dumps({\"ok\": False, \"error\": \"missing \" + LOG}))\n        return 1\n    with open(LOG, encoding=\"utf-8\", errors=\"replace\") as f:\n        cycles = parse(f.read().splitlines())\n\n    for n in sorted(cycles):\n        c = cycles[n]\n        cost = \"$?\" if c[\"usd\"] is None else \"$%.4f\" % c[\"usd\"]\n        if c[\"rounds\"]:\n            ended = \"ended %s (rounds: %s)\" % (c[\"rounds\"][-1][1], \", \".join(\"r%d %s\" % r for r in c[\"rounds\"]))\n        else:\n            ended = \"no assignment rounds\"\n        print(\"cycle %3d  %9s  %s\" % (n, cost, ended))\n\n    with_rounds = [c for c in cycles.values() if c[\"rounds\"]]\n    all_rounds = [o for c in with_rounds for _, o in c[\"rounds\"]]\n    print(\"RESULT \" + json.dumps({\n        \"ok\": True,\n        \"cycles\": len(cycles),\n        \"total_usd\": round(sum(c[\"usd\"] for c in cycles.values() if c[\"usd\"] is not None), 4),\n        \"unpriced_cycles\": sorted(n for n, c in cycles.items() if c[\"usd\"] is None),\n        \"cycles_with_rounds\": len(with_rounds),\n        \"cycles_ended_purpose_met\": sum(c[\"rounds\"][-1][1] == \"PURPOSE_MET\" for c in with_rounds),\n        \"cycles_ended_handback\": sum(c[\"rounds\"][-1][1] == \"HANDBACK\" for c in with_rounds),\n        \"rounds_purpose_met\": all_rounds.count(\"PURPOSE_MET\"),\n        \"rounds_handback\": all_rounds.count(\"HANDBACK\"),\n    }))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":100,"startLine":1,"totalLines":100}}}
