{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YRikN4WKbvCMgca2C8DkMJ","type":"tool_result","content":"2825\t\n2826\t\n2827\tEL_OCR_ALIASES = ((\"vl\", \"vi\"), (\"v\", \"y\"))                                         # == errorlist_check.OCR_ALIASES\n2828\tEL_TOTAL_TOL = 3                                                                    # PD354(a): RETURN when |total diff| > 3\n2829\t\n2830\t\n2831\tdef el_norm_ocr(s):\n2832\t    \"\"\"An Error List text -> lower-case alphanumerics with the OCR aliases applied (== errorlist_check.norm). Returns a str.\"\"\"\n2833\t    import re as _re\n2834\t    k = _re.sub(r\"[^a-z0-9]\", \"\", (s or \"\").lower())\n2835\t    for a, b in EL_OCR_ALIASES:\n2836\t        k = k.replace(a, b)\n2837\t    return k\n2838\t\n2839\t\n2840\tdef el_class(it):\n2841\t    \"\"\"One Error List item {raw, detail} -> its class: elrule.item_class's local / cond / sr, else input, else\n2842\t    'other:<el_norm_ocr(raw)>' (the scratch recipes' elcls). Self-test: tools/bench/selftest_t7_ring.py.\"\"\"\n2843\t    c = pure(\"elrule\").item_class(\"{0} {1}\".format(it.get(\"raw\", \"\"), it.get(\"detail\", \"\")))\n2844\t    if c:\n2845\t        return c\n2846\t    k = el_norm_ocr(it.get(\"raw\"))\n2847\t    if \"unwiredorbadterminal\" in k or (\"requiredinput\" in k and \"notwired\" in k):\n2848\t        return \"input\"\n2849\t    return \"other:\" + k\n2850\t\n2851\t\n2852\tdef el_advisory(items, pred_path, plan_path, pred=None):\n2853\t    \"\"\"(rc, report) for one Error List read (its items) against the pred's errorlist.per_class (PD354(a), ADVISORY): rc 1 only for\n2854\t    a class in neither the start read nor the prediction, or |total diff| > EL_TOTAL_TOL; rc 2 when the pred (read from pred_path\n2855\t    when `pred` is None) is not keyed to plan_path's md5 or has no per_class block; else 0 (the difference is recorded).\n2856\t    Self-test: el_advisory_selftest / tools/bench/selftest_t7_ring.py.\"\"\"\n2857\t    import collections\n2858\t    pr = pred if pred is not None else jload(pred_path)\n2859\t    el = pr.get(\"errorlist\") or {}\n2860\t    pc = el.get(\"per_class\") or {}\n2861\t    if pred is None and (pr.get(\"plan\") or {}).get(\"md5\") != md5(plan_path):\n2862\t        return 2, {\"why\": \"pred not keyed to plan md5\"}\n2863\t    if not pc.get(\"predicted\"):\n2864\t        return 2, {\"why\": \"pred has no errorlist.per_class\"}\n2865\t    start, want = pc[\"start_read\"][\"classes\"], pc[\"predicted\"]\n2866\t    got = collections.Counter(el_class(x) for x in items or [])\n2867\t    diff = dict((c, got.get(c, 0) - want.get(c, 0)) for c in sorted(set(got) | set(want)) if got.get(c, 0) != want.get(c, 0))\n2868\t    unseen = sorted(c for c in got if c not in start and c not in want)\n2869\t    td = len(items or []) - int(el[\"predicted_total\"])\n2870\t    rc = 1 if (unseen or abs(td) > EL_TOTAL_TOL) else 0\n2871\t    return rc, {\"read_total\": len(items or []), \"pred_total\": el[\"predicted_total\"], \"total_diff\": td, \"per_class_diff\": diff, \"unseen\": unseen,\n2872\t                \"verdict\": \"RETURN\" if rc else \"RECORDED\"}\n2873\t\n2874\t\n2875\tdef el_advisory_print(rc, rep):\n2876\t    \"\"\"Print the one EL-ADVISORY line of an el_advisory result.\"\"\"\n2877\t    print(\"EL-ADVISORY total read {0} pred {1} diff {2:+}; per-class diff (read - pred) {3}; unseen classes {4}; verdict {5} rc {6}\".format(\n2878\t        rep.get(\"read_total\"), rep.get(\"pred_total\"), rep.get(\"total_diff\", 0), json.dumps(rep.get(\"per_class_diff\"), sort_keys=True),\n2879\t        rep.get(\"unseen\"), rep.get(\"verdict\", rep.get(\"why\")), rc), flush=True)\n2880\t\n2881\t\n2882\tdef el_advisory_selftest(pred_path, plan_path):\n2883\t    \"\"\"Four synthetic Error List reads built from the pred's predicted per-class counts (offline, the scratch recipes'\n2884\t    el_selftest): unseen class -> 1; total +4 -> 1; total +2 known -> 0; the prediction itself -> 0. Prints the RESULT line and"}]},"parent_tool_use_id":null,"session_id":"e4a59a87-4d15-41da-99bd-766041ad1a3b","uuid":"8ed7d9af-0e0a-4d05-83cf-47a4d2ad66d2","timestamp":"2026-10-12T12:58:34.148Z","tool_use_result":{"type":"text","file":{"filePath":"G:\\Codes\\LabVIEW_Codes\\MinLab\\zz_LabView VI\\AAA_UNIST\\2. Tracking\\V6_ParallelLoop\\tools\\stagekit.py","content":"\n\nEL_OCR_ALIASES = ((\"vl\", \"vi\"), (\"v\", \"y\"))                                         # == errorlist_check.OCR_ALIASES\nEL_TOTAL_TOL = 3                                                                    # PD354(a): RETURN when |total diff| > 3\n\n\ndef el_norm_ocr(s):\n    \"\"\"An Error List text -> lower-case alphanumerics with the OCR aliases applied (== errorlist_check.norm). Returns a str.\"\"\"\n    import re as _re\n    k = _re.sub(r\"[^a-z0-9]\", \"\", (s or \"\").lower())\n    for a, b in EL_OCR_ALIASES:\n        k = k.replace(a, b)\n    return k\n\n\ndef el_class(it):\n    \"\"\"One Error List item {raw, detail} -> its class: elrule.item_class's local / cond / sr, else input, else\n    'other:<el_norm_ocr(raw)>' (the scratch recipes' elcls). Self-test: tools/bench/selftest_t7_ring.py.\"\"\"\n    c = pure(\"elrule\").item_class(\"{0} {1}\".format(it.get(\"raw\", \"\"), it.get(\"detail\", \"\")))\n    if c:\n        return c\n    k = el_norm_ocr(it.get(\"raw\"))\n    if \"unwiredorbadterminal\" in k or (\"requiredinput\" in k and \"notwired\" in k):\n        return \"input\"\n    return \"other:\" + k\n\n\ndef el_advisory(items, pred_path, plan_path, pred=None):\n    \"\"\"(rc, report) for one Error List read (its items) against the pred's errorlist.per_class (PD354(a), ADVISORY): rc 1 only for\n    a class in neither the start read nor the prediction, or |total diff| > EL_TOTAL_TOL; rc 2 when the pred (read from pred_path\n    when `pred` is None) is not keyed to plan_path's md5 or has no per_class block; else 0 (the difference is recorded).\n    Self-test: el_advisory_selftest / tools/bench/selftest_t7_ring.py.\"\"\"\n    import collections\n    pr = pred if pred is not None else jload(pred_path)\n    el = pr.get(\"errorlist\") or {}\n    pc = el.get(\"per_class\") or {}\n    if pred is None and (pr.get(\"plan\") or {}).get(\"md5\") != md5(plan_path):\n        return 2, {\"why\": \"pred not keyed to plan md5\"}\n    if not pc.get(\"predicted\"):\n        return 2, {\"why\": \"pred has no errorlist.per_class\"}\n    start, want = pc[\"start_read\"][\"classes\"], pc[\"predicted\"]\n    got = collections.Counter(el_class(x) for x in items or [])\n    diff = dict((c, got.get(c, 0) - want.get(c, 0)) for c in sorted(set(got) | set(want)) if got.get(c, 0) != want.get(c, 0))\n    unseen = sorted(c for c in got if c not in start and c not in want)\n    td = len(items or []) - int(el[\"predicted_total\"])\n    rc = 1 if (unseen or abs(td) > EL_TOTAL_TOL) else 0\n    return rc, {\"read_total\": len(items or []), \"pred_total\": el[\"predicted_total\"], \"total_diff\": td, \"per_class_diff\": diff, \"unseen\": unseen,\n                \"verdict\": \"RETURN\" if rc else \"RECORDED\"}\n\n\ndef el_advisory_print(rc, rep):\n    \"\"\"Print the one EL-ADVISORY line of an el_advisory result.\"\"\"\n    print(\"EL-ADVISORY total read {0} pred {1} diff {2:+}; per-class diff (read - pred) {3}; unseen classes {4}; verdict {5} rc {6}\".format(\n        rep.get(\"read_total\"), rep.get(\"pred_total\"), rep.get(\"total_diff\", 0), json.dumps(rep.get(\"per_class_diff\"), sort_keys=True),\n        rep.get(\"unseen\"), rep.get(\"verdict\", rep.get(\"why\")), rc), flush=True)\n\n\ndef el_advisory_selftest(pred_path, plan_path):\n    \"\"\"Four synthetic Error List reads built from the pred's predicted per-class counts (offline, the scratch recipes'\n    el_selftest): unseen class -> 1; total +4 -> 1; total +2 known -> 0; the prediction itself -> 0. Prints the RESULT line and","numLines":60,"startLine":2825,"totalLines":3277}}}
