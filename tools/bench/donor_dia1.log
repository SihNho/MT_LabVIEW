import os,sys
sys.path.insert(0,os.path.abspath('tools'))
import gscript as g
g._lv=None
for name in ('DONOR_Ex3_PrimitiveFunctions.vi','DONOR_Ex1_GetControlsWireIndicators.vi'):
    D=os.path.join(g.CLAUDEDEV,name)
    print('='*70); print(name)
    for d in (0,1):
        try: nodes,_=g.net_map(D, diagram_index=d, max_nodes=60, max_terms=10)
        except Exception as e: print(' dia',d,'FAIL',str(e)[:70]); continue
        print(' --- diagram',d)
        for i,(uid,lbl,terms) in nodes.items():
            print('   node[%d] uid %-6s %s'%(i,uid,[nm for _,nm,_ in terms if nm]))

