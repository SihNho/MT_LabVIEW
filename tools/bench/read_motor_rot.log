import os,sys,shutil,time
sys.path.insert(0,os.path.abspath('tools'))
import gscript as g
g._lv=None
SRC=r'G:\Codes\LabVIEW_Codes\MinLab\zz_LabView VI\SiHyeong Modified\Motor control v5_No Recording.vi'
DST=os.path.join(g.CLAUDEDEV,'READ_motorv5.vi')
if os.path.exists(DST): os.remove(DST)
shutil.copyfile(SRC,DST); time.sleep(0.3)
n=g.count(DST,'Diagram'); print('diagrams:',n)
KEY=('rot','turn','deg','angle','pos','visa','last','accum','current')
for d in range(n):
    try: nodes,_=g.net_map(DST, diagram_index=d, max_nodes=60, max_terms=16)
    except Exception as e: print(' dia',d,'FAIL',str(e)[:70]); continue
    hits=[]
    for i,(uid,lbl,terms) in nodes.items():
        names=[nm for _,nm,_ in terms if nm]
        low=' | '.join(names).lower()
        if any(k in low for k in KEY): hits.append((uid,names))
    if hits:
        print('=== diagram %d : %d nodes'%(d,len(nodes)))
        for uid,names in hits: print('   uid %-6s %s'%(uid,names[:12]))
try: g.close_panel(DST)
except Exception: pass
time.sleep(0.3)
try: os.remove(DST)
except OSError: pass
print('done')

