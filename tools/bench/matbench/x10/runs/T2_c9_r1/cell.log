, True\r\n101: \r\n102: \r\n103: def body(_stage):\r\n104:     W = s.start(); s.es(\"after open\"); rows = []; done = []; B = K.mod(\"build_d1_v0\")\r\n105:     s.fact(\"SITE 1 OMITTED: no frame-grab node in loop #637 (Grab #15403 is on #15266, Get Image #22692 on #22650) - card 90-5 pass 1\")\r\n106:     for k, (site, wire, didx, duid, loop_uid) in enumerate(SITES):\r\n107:         cls = \"WhileLoop\"\r\n108:         if not loop_uid:                                  # For body: its owner loop read live (owner_of strict uid echo); a case frame has no `.Diagram`\r\n109:             ocls, ouid = s.safe(\"owner_of(#%d)\" % duid, lambda: B.owner_of(W, duid, strict=True), (None, None))[0] or (None, None)\r\n110:             s.fact(\"S%02d owner of diagram #%d: %r #%r\" % (site, duid, ocls, ouid))\r\n111:             if ocls != \"ForLoop\":\r\n112:                 s.fact(\"S%02d SKIPPED: diagram #%d is a %r frame - OpCreateConstOnTerm_v0 addresses Loop.Diagram only (no constant creator for a case frame)\" % (site, duid, ocls))\r\n113:                 rows.append({\"site\": site, \"skipped\": ocls}); continue\r\n114:             cls, loop_uid = \"ForLoop\", ouid\r\n115:         row, ok = one_site(W, k, site, wire, didx, duid, loop_uid, cls); rows.append(row)\r\n116:         if ok:\r\n117:             done.append(site)\r\n118:     s.R[\"rows_t0\"] = rows; s.R[\"sites_done\"] = done\r\n119:     es = s.es(\"after all sites\"); s.gate(\"E1 ExecState 1 after %d/%d sites\" % (len(done), len(SITES)), es == 1)\r\n120:     JC, Wb = K.mod(\"jev_candidates\"), K.mod(\"wiki_build\"); G1 = JC.load(JC.S1_KEY)\r\n121:     lv = Wb.read_live(W, fs_pairs=G1[\"wiki\"][\"fs_tunnel_pairs\"]); s.fact(\"LIVE MAP %r\" % lv[\"secs\"])\r\n122:     loops = json.load(open(JC._newest(\"graph_loops_s1_*.json\"), encoding=\"utf-8\"))[\"loops\"]\r\n123:     G2 = JC.from_parts({\"terminals\": lv[\"terminals\"], \"graph_summary\": G1[\"wiki\"][\"graph_summary\"]}, lv[\"objs\"], loops, JC.node_labels_defaul