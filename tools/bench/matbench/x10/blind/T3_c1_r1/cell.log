+def digest(path):
+    return hashlib.md5((ROOT / path).read_bytes()).hexdigest()
+
+def line(path, literal):
+    hits = [i for i, s in enumerate((ROOT / path).read_text(encoding="utf-8-sig").splitlines(), 1) if literal in s]
+    assert len(hits) == 1, (path, literal, hits)
+    return f"{path}:{hits[0]}"
+
+def get_net(step, term):
+    terminals = step["state"]["terminals"]
+    sinks = [t for t in terminals if t["term_uid"] == term]
+    assert len(sinks) == 1
+    sink = sinks[0]
+    assert sink["wire_uid"] != 0
+    net = [t for t in terminals if t["wire_uid"] == sink["wire_uid"]]
+    sources = [t for t in net if t["is_source"]]
+    destinations = [t for t in net if not t["is_source"]]
+    assert len(sources) == len(destinations) == 1
+    return sources[0], sink, net
+
+if __name__ == "__main__":
+    stage_path = "tools/bench/stage_d1_l2a1.json"
