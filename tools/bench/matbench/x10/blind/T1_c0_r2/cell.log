n  \"gui\": false,\r\n  \"hardware\": \"none\",\r\n  \"run_vi\": false,\r\n  \"write\": [\r\n   \"tools/bench/diag_c89_*\",\r\n   \"tools/bench/sim/t0/**\",\r\n   \"tools/bench/t0_insitu_89*\",\r\n   \"tools/bench/cards/**\"\r\n  ],\r\n  \"status_edit\": false,\r\n  \"git_commit\": false,\r\n  \"peers\": []\r\n },\r\n \"budget\": {\r\n  \"failures\": 2,\r\n  \"minutes\": 15\r\n },\r\n \"rules\": [\r\n  \"REPLAY chat-N2: LabVIEW/GUI/hardware/peers/git forbidden (hook); do all offline, report the rest\",\r\n  \"rule 1a: stamps change no computed value; computation_diff 0 is the gate; diagnostic copy is never delivered\",\r\n  \"never edit/save D1_s1_copy.vi, kswap, originals, or the L2-A1 bed\",\r\n  \"missing verb/helper may be built: <=120 lines stagekit, negative self-test, handle-flat\",\r\n  \"bead picking as drive_m8_load83 does, lv_gui capture->act->confirm, Exception Approved\",\r\n  \"no beads: garbage tracking is not a failure\",\r\n  \"failed gate -> JEV-LADDER first; review owed -> hypothesis review then stop\",\r\n  \"facts only, no design recommendation; result/1 <=10 facts <=3 open\"\r\n ],\r\n \"advances\": [\r\n  \"M8\",\r\n  \"M3\",\r\n  \"R1\",\r\n  \"R3\"\r\n ]\r\n}\r\n","exit_code":0,"status":"completed"}}
