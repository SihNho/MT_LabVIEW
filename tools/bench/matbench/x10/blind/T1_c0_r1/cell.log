ntools/bench/drive_m8_load83.py:62:        r = subprocess.run([sys.executable, \"-u\", os.path.join(HERE, \"drive_m8.py\"), \"--leg\", leg, \"--picks\", str(n),\r\ntools/bench/drive_m8_load83.py:71:        jp = os.path.join(HERE, \"m8_%s_p%d_r%d.json\" % (leg, n, RUN_S))\r\ntools/bench/drive_m8_load83.py:75:        row = {\"leg\": tag, \"hz_cell\": hz, \"picks\": n, \"run_s\": RUN_S, \"rc\": r.returncode, \"secs\": round(time.time() - t),\r\ntools/bench/drive_m8_load83.py:78:               \"frames_delta\": fd, \"measured_hz\": (round(fd / secs_run, 1) if isinstance(fd, (int, float)) and fd else None),\r\ntools/bench/drive_m8_load83.py:79:               \"lost_frames\": j.get(\"total_lost_frames\"),\r\ntools/bench/drive_m8_load83.py:86:        gates[\"T1 %s leg rc 0\" % tag] = r.returncode == 0\r\ntools/bench/drive_m8_load83.py:98:                                  [{\"path\": os.path.relpath(jp, ROOT), \"md5\": md5(jp)}])), flush=True)\r\ntools/bench/drive_m8.py:1:r\"\"\"drive_m8.py - M8 (a): one REAL RUN leg of a dated byte copy, driven by the D0 driver v5 (card 74-1).\r\ntools/bench/drive_m8.py:3:FOUND FIRST: tools/bench/drive_original_copy_v5.py (the whole D0 leg: picks, done, bandpass, save dialog,\r\ntools/bench/drive_m8.py:6:(COPY/ORIGINAL/RUN_DIR/json paths) - v5 itself is NOT edited. Only its FIRST leg runs (plan: \"full leg once\").\r\ntools/bench/drive_m8.py:7:    --leg bed   copy of claudeDev\\D1_s4_loop17.vi (md5 4b621946...) -> claudeDev\\D1_s4_loop17_run_<ts>.vi\r\ntools/bench/drive_m8.py:8:    --leg base  copy of the bed's own source original `Min_Track N beads V6_ParallelLoop.vi` (2a78e17c...,\r\ntools/bench/drive_m8.py:9:                tools/recipes/stage_d1_s1.py:226) -> claudeDev\\m8_orig_copy_<ts>.vi\r\ntools/bench/drive_m8.py:10:    --leg s3    card 74-4 (M8', plan PD 9): copy of claudeDev\\D1_s3_loop15.vi (1a11d92a...) -> ..._run_<ts>.vi;\r\ntools/bench/drive_m8.py:15: M1 run copy md5 == source md5 before launch      M2 v5 leg reaches the experiment loop (L7+L8+L9 pass)\r\ntools/bench/drive_m8.py:18: M6 LabVIEW gone (tasklist)   M7 bed md5 unchanged   M8 run copy deleted\r\ntools/bench/drive_m8.py:27:S1, S1_MD5 = os.path.join(CD, \"D1_s1_copy.vi\"), \"3e3d23cefd3a334001aa9d6156bf1aee\"   # card 77-6 (wiki index.json:1887)\r\ntools/bench/drive_m8.py:30:A = sys.argv[1:]; DRY = \"--dry\" in A; LEG = A[A.index(\"--leg\") + 1] if \"--leg\" in A else None\r\ntools/bench/drive_m8.py:31:# card 77-6: --picks N (1/3/6) sets v5.PICK_FRACS; output json m8_<leg>_p<N>.json so cycle-74 files stay as they are.\r\ntools/bench/drive_m8.py:43:def md5(p):\r\ntools/bench/drive_m8.py:44:    import hashlib; return hashlib.md5(open(p, \"rb\").read()).hexdigest()\r\ntools/bench/drive_m8.py:57:    legs = {(\"s3_loop15\" if k == \"s3\" else k): json.load(open(os.path.join(HERE, \"m8_%s.json\" % k))) for k in ks}\r\ntools/bench/drive_m8.py:59:    json.dump({\"schema\": \"m8-run1/1\", \"legs\": legs}, open(jp, \"w\"), indent=1)\r\ntools/bench/drive_m8.py:60:    print(P.result_line(P.make_result(1, 0, None, [{\"path\": os.path.relpath(jp, ROOT), \"md5\": md5(jp)}])))\r\ntools/bench/drive_m8.py:63:    import drive_original_copy_v5 as v5\r\ntools/bench/drive_m8.py:65:    src, smd5, name = {\"bed\": (BED, BED_MD5, \"D1_s4_loop17_run_%s.vi\"), \"base\": (ORIG, ORIG_MD5, \"m8_orig_copy_%s.vi\"),\r\ntools/bench/drive_m8.py:67:                       \"s1\": (S1, S1_MD5, \"D1_s1_copy_run_%s.vi\")}.get(LEG, (None, None, None))\r\ntools/bench/drive_m8.py:68:    if LEG in (\"replay_s1\", \"replay_s3\"):                               # card 78-3 (PD22(d)): a swapped replay copy, --src <vi>\r\ntools/bench/drive_m8.py:69:        src = os.path.normpath(A[A.index(\"--src\") + 1]); smd5 = md5(src)   # normpath: LabVIEW error 7 on '/' (78-3 run 1)         # its md5 is re-read after the run (M7)\r\ntools/bench/drive_m8.py:71:    name = name % TS                                          # rs legs run BESIDE the replay VIs (same folder)\r\ntools/bench/drive_m8.py:72:    copy = os.path.join(tempfile.gettempdir() if DRY else (os.path.dirname(src) if LEG.startswith(\"replay\") else CD), name)\r\ntools/bench/drive_m8.py:73:    shutil.copyfile(src, copy)\r\ntools/bench/drive_m8.py:74:    G = {\"M1 run copy md5 == source\": md5(copy) == smd5 == md5(src)}\r\ntools/bench/drive_m8.py:77:        m.COPY, m.ORIGINAL, m.ORIGINAL_MD5, m.RUN_DIR = copy, ORIG, ORIG_MD5, run_dir\r\ntools/bench/drive_m8.py:88:    real_leg, n = v5.leg, [0]\r\ntools/bench/drive_m8.py:89:    def one_leg(tag, *a):                                      # plan step 2: the full leg ONCE\r\ntools/bench/drive_m8.py:91:        return real_leg(tag, *a) if n[0] == 1 else True\r\ntools/bench/drive_m8.py:92:    v5.leg = one_leg\r\ntools/bench/drive_m8.py:93:    if not G[\"M1 run copy md5 == source\"]:\r\ntools/bench/drive_m8.py:94:        v5.rec(\"M1 REFUSED\", \"FILE\", False, \"copy md5 mismatch\"); v5.report()\r\ntools/bench/drive_m8.py:118:    G[\"M7 bed md5 unchanged\"] = md5(BED) == BED_MD5 and md5(S3) == S3_MD5 and md5(ORIG) == ORIG_MD5 and \\\r\ntools/bench/drive_m8.py:119:        md5(S1) == S1_MD5 and md5(src) == smd5\r\ntools/bench/drive_m8.py:120:    try: os.remove(copy)\r\ntools/bench/drive_m8.py:121:    except OSError as e: print(\"delete copy failed: %r\" % e)\r\ntools/bench/drive_m8.py:122:    G[\"M8 run copy deleted\"] = not os.path.exists(copy)\r\ntools/bench/drive_m8.py:123:    out = {\"leg\": LEG, \"dry\": DRY, \"copy\": copy, \"source\": src, \"source_md5\": smd5, \"run_dir\": run_dir,\r\ntools/bench/drive_m8.py:125:           \"total_lost_frames\": lost, \"stop\": stop, \"files\": files,\r\ntools/bench/drive_m8.py:138:                                      [{\"path\": os.path.relpath(jp, ROOT), \"md5\": md5(jp)}])), flush=True)\r\ntools/bench/drive_m8.py:143:    assert LEG in (\"bed\", \"base\", \"s3\", \"s1\", \"replay_s1\", \"replay_s3\"), \"--leg bed|base|s3|s1|replay_s1|replay_s3 (replay_*: --src <swapped copy>)\"\r\n","exit_code":0,"status