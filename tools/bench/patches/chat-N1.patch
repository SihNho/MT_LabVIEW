+def _req_op(name, where=None):
+    base = name[:-3] if name.lower().endswith(".vi") else name
+    for d in ([os.path.join(CLAUDEDEV, where)] if where else [os.path.join(CLAUDEDEV, "ops"), CLAUDEDEV]):
+        p = os.path.join(d, base + ".vi")
+        if os.path.isfile(p):
