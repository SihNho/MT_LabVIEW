import os,sys,json
sys.path.insert(0,os.path.abspath('tools'))
import gscript as g
g._lv=None
WORK=r'G:\Codes\LabVIEW_Codes\MinLab\zz_LabView VI\AAA_UNIST\2. Tracking\Min_Track N beads V6_ParallelLoop.vi'
KEY=('cycle','schedule','force','mag','rot','speed','wait','numcol','time','sub','pos','arr','index','row','col')
out={}
for d in (160,161,162,163,165,168):
    try: nodes,_=g.net_map(WORK, diagram_index=d, max_nodes=60, max_terms=20)
    except Exception as e: print('dia',d,'FAIL',str(e)[:80]); continue
    print('=== diagram %d : %d nodes'%(d,len(nodes)))
    rows=[]
    for i,(uid,lbl,terms) in nodes.items():
        names=[nm for _,nm,_ in terms if nm]
        low=' | '.join(names).lower()
        hit=sorted({k for k in KEY if k in low})
        rows.append({'uid':uid,'terms':names,'hit':hit})
        mark='   <== '+','.join(hit) if hit else ''
        print('   uid %-6s %s%s'%(uid,names[:12],mark))
    out[str(d)]=rows
json.dump(out,open('tools/bench/cycle_cluster.json','w',encoding='utf-8'),indent=1)
print('written')

