beead4c37f142a8808a66de) WITHOUT touching the working-tree tools/stagekit.py.\n\nHow: the HEAD source is read with `git show` into memory (md5 checked, refuse on mismatch), executed as module\n'stagekit' with __file__ = <root>/tools/stagekit.py (so its HERE/ROOT/BENCH and sys.path inserts are the real ones),\nand open() of <root>/tools/stagekit.py is redirected to that same HEAD source (selftest_stagekit case F reads the file,\nselftest_stagekit.py:151). Then the self-test runs via runpy as __main__. Nothing opens COM or starts LabVIEW.\nPrior art: no existing old-vs-new runner (ls tools/bench | grep -i old_stagekit: none); 147-b1-2 used git-stash-free copies too.\nPrediction: the same PASS/FAIL counts as the run against the new stagekit 06b8d844.\nUsage: py -u tools/bench/diag_c147_b1_3_old/run_old.py tools/bench/<selftest>.py\n\"\"\"\nimport builtins\nimport hashlib\nimport io\nimport os\nimport runpy\nimport subprocess\nimport sys\nimport types\n\nROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\", \"..\"))\nTOOLS = os.path.join(ROOT, \"tools\")\nREAL = os.path.join(TOOLS, \"stagekit.py\")\nWANT = \"9a3fceaf6beead4c37f142a8808a66de\"\n\nraw = subprocess.check_output([\"git\", \"-C\", ROOT, \"show\", \"HEAD:tools/stagekit.py\"])\nmd5 = hashlib.md5(raw).hexdigest()\nprint(\"OLD-STAGEKIT md5 {0} (want {1})\".format(md5, WANT), flush=True)\nif md5 != WANT:\n    print(\"REFUSE: HEAD stagekit md5 mismatch\", flush=True)\n    sys.exit(2)\nSRC = raw.decode(\"utf-8\")\n\n_real_open = builtins.open\n_key = os.path.normcase(os.path.abspath(REAL))\n\n\ndef _open(file, mode=\"r\", *a, **kw):\n    if isinstance(file, str) and os.path.normcase(os.path.abspath(file)) == _key and \"r\" in mode and \"b\" not in mode:\n        print(\"OPEN-REDIRECT tools/stagekit.py -> HEAD source\", flush=True)\n        return io.StringIO(SRC)\n    return _real_open(file, mode, *a, **kw)\n\n\nbuiltins.open = _open\nif TOOLS not in sys.path:\n    sys.path.insert(0, TOOLS)\nmod = types.ModuleType(\"stagekit\")\nmod.__file__ = REAL\nsys.modules[\"stagekit\"] = mod\nexec(compile(SRC, REAL, \"exec\"), mod.__dict__)\ntarget = os.path.abspath(sys.argv[1])\nsys.argv = [target]\nrunpy.run_path(target, run_name=\"__main__\")\n"}},{"tool_name":"Bash","tool_use_id":"toolu_01TDgyN1zwcEt9m33dsrj61Y","tool_input":{"command":"cd \"G:/Codes/LabVIEW_Codes/MinLab/zz_LabView VI/AAA_UNIST/2. Tracking/V6_ParallelLoop\" && py tools/bgrun.py --material --max-min 3 --log tools/bench/selftest_stagekit_c147b13_new.log -- py -u tools/bench/selftest_stagekit.py","timeout":240000,"description":"Run selftest_stagekit against new stagekit"}},{"tool_name":"Bash","tool_use_id":"toolu_01SwrH3AucFxG7EJroEBe7Tj","tool_input":{"command":"cd \"G:/Codes/LabVIEW_Codes/MinLab/zz_LabView VI/AAA_UNIST/2. Tracking/V6_ParallelLoop\" && py tools/bgrun.py --material --max-min 3 --log tools/bench/selftest_td_key_c147b13_new.log -- py -u tools/bench/selftest_td_key_c141_3.py","timeout":240000,"description":"Run selftest_td_key against new stagekit"}},{"tool_name":"Task","tool_use_id":"toolu_01E8fYDhEWgEN1Uwzc6BN3Ge","tool_input":{"description":"T6 before/after self-test compare","prompt":"CARD tools/bench/cards/task_147-b1-4.json","subagent_type":"material","run_in_background":false}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":3,"requested":{"background":0,"foreground":3,"unset":0},"started_in_background":0,"max_depth":1,"spawned_by_subagents":0,"completed":3,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{"material":3}},"is_error":false,"num_turns":46,"subtype":"success","api_error_status":null,"result":"HANDBACK (`assign_result_147_2.json`, validated). The stagekit gate fix is built and passes its own tests (17/0), but `selftest_stagekit.py` fails 47/2 on the new stagekit. A stray COM call at J1 (`