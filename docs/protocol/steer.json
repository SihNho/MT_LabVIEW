{
  "$id": "steer/1",
  "description": "Outcome-review STEERING card (user 2026-09-24: '아웃컴 리뷰에 조향카드 부여하는 것 동의'). Written by outcome_review.py when a verdict REPEATS (a slug in this review and the previous one). The runner carries it in cycle/1 `steer`; the judgement session answers it in next/1 `steer` (follow, or refuse with evidence). Two refusals of the same `item` stop the runner and add a decisions_pending item.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cycle", "item", "verdicts", "required_act", "goal_ids", "evidence"],
  "properties": {
    "schema": {"const": "steer/1"},
    "cycle": {"type": "integer", "minimum": 0},
    "item": {"type": "string", "pattern": "^outcome:[a-z+-]{1,200}$"},
    "verdicts": {"type": "array", "minItems": 1, "items": {"enum": [
      "goal-requirement-not-advanced", "tooling-over-delivery", "product-not-runnable", "ordering-stale",
      "decision-starved", "scope-inflation", "measurement-without-product"]}},
    "required_act": {"type": "string", "minLength": 1, "maxLength": 600},
    "goal_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/goalid"}},
    "evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/fileref"}},
    "note": {"type": "string", "maxLength": 300, "x-prose": true, "x-limit": true}
  },
  "definitions": {
    "goalid": {"type": "string", "pattern": "^(R[0-9]+(\\.[0-9]+)*|M[0-9]+[a-z]?)$"},
    "fileref": {"type": "object", "additionalProperties": false, "required": ["path"],
                "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 400},
                               "md5": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"}}}
  }
}
