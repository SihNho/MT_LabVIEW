{
  "$id": "review/1",
  "description": "C4 - judgement -> peer (hypothesis, prior-art, fact, outcome, retrospective; + ingest for doc_ingest.py, added 2026-09-24 when doc_ingest was wired).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "role", "claim", "ask"],
  "properties": {
    "schema": {"const": "review/1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,40}$"},
    "role": {"enum": ["hypothesis", "priorart", "fact", "outcome", "retrospective", "ingest"]},
    "claim": {"type": "string", "minLength": 1, "maxLength": 300},
    "predicted": {"type": "string", "maxLength": 300},
    "observed": {"type": "string", "maxLength": 300},
    "ruled_out": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 200}},
    "attachments": {"type": "array", "items": {"$ref": "#/definitions/fileref"}},
    "ask": {"enum": ["refute"]},
    "note": {"type": "string", "maxLength": 300}
  },
  "definitions": {
    "fileref": {"type": "object", "additionalProperties": false, "required": ["path"],
                "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 400},
                               "md5": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"}}}
  }
}
